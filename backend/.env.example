# Copy to .env for local overrides. Shell environment variables take precedence.
# Tiger Data connection URL
DATABASE_URL=

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.stressforecast.app

# Auth0 user IDs for the dedicated demo accounts used by the seed script
DEMO_STUDENT_SUB=
DEMO_REP_SUB=

# Fill in the Gemini API key and the team's Gemini Flash model ID.
GEMINI_API_KEY=
GEMINI_MODEL=

# Comma-separated browser origins, without trailing slashes
CORS_ORIGINS=http://localhost:5173
