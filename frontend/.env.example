# Copy to .env and fill in. Never commit .env.

# Backend API base URL
VITE_API_URL=http://localhost:8000/api

# true = answer from src/mocks/ (default); false = call the real API
VITE_USE_MOCKS=true

# Auth0 (docs/architecture.md §5). Leave DOMAIN or CLIENT_ID empty to use the demo login
# (pick "student" or "rep", no real accounts). Set both to use real Auth0 login.
# In the Auth0 application settings, allow http://localhost:5173 as a callback URL,
# logout URL and web origin, and enable Refresh Token Rotation.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.stressforecast.app
